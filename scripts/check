#!/usr/bin/env bash
# 本地检查：shellcheck + Python 语法 + bats 测试。
# 用法：scripts/check [lint|test]；未全局安装 bats/shellcheck 时自动退回 bunx 或 npx。
set -euo pipefail
cd "$(dirname "$0")/.."

tool() { # <命令名>：输出可执行的命令前缀
  if command -v "$1" >/dev/null; then echo "$1"
  elif command -v bunx >/dev/null; then echo "bunx $1"
  elif command -v npx >/dev/null; then echo "npx --yes $1"
  else echo "scripts/check: 找不到 $1，也没有 bunx/npx" >&2; exit 1
  fi
}

lint() {
  $(tool shellcheck) bin/marginalia scripts/check
  for f in lib/helpers.py integrations/trine/bin/trine-ext; do
    python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$f"
  done
  # bash 3.2 会把紧跟在 $var 后的非 ASCII 字节当成变量名的一部分，必须写成 ${var}
  python3 - bin/marginalia scripts/check <<'PY'
import re, sys
bad = [(p, n + 1, line.strip()) for p in sys.argv[1:]
       for n, line in enumerate(open(p, encoding="utf-8"))
       if re.search(r"\$[A-Za-z_][A-Za-z0-9_]*[^\x00-\x7f]", line)]
for p, n, line in bad:
    print("%s:%d: 变量后紧跟非 ASCII 字符，请写成 ${var}：%s" % (p, n, line))
sys.exit(1 if bad else 0)
PY
  echo "lint ok"
}

run_tests() { $(tool bats) test/; }

case ${1:-all} in
  lint) lint ;;
  test) run_tests ;;
  all) lint; run_tests ;;
  *) echo "用法：scripts/check [lint|test]" >&2; exit 1 ;;
esac
