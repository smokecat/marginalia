{
  "apiVersion": 1,
  "id": "marginalia",
  "name": "Marginalia 任务",
  "version": "0.1.0",
  "description": "显示项目 .local/ 里的任务，关联会话、一键接续",
  "entry": ["bin/trine-ext"],
  "contributes": {
    "sessionPanel": { "title": "任务", "icon": "list-checks" },
    "workspacePanel": { "title": "任务", "icon": "list-checks" },
    "sessionBadge": true,
    "linkPicker": { "title": "关联任务", "multiple": true },
    "composerAction": { "label": "任务", "icon": "list-checks" }
  },
  "capabilities": ["prompt.insert", "prompt.send", "session.create", "links.write", "invoke"]
}
