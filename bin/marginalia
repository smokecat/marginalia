#!/usr/bin/env bash
# marginalia — 项目私有工作区（默认 .margin/，目录名可配置）的确定性操作。任何 agent 工具或人都可直接调用。
# 依赖：bash ≥ 3.2、git ≥ 2.31、python3 ≥ 3.8
set -euo pipefail

SELF=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")
MARGINALIA_HOME=$(dirname "$(dirname "$SELF")")
TPL="$MARGINALIA_HOME/templates"
VERSION=$(cat "$MARGINALIA_HOME/VERSION")
TODAY=$(date +%F)
STATUSES="active paused blocked done"
PREV_DIR=""  # migrate 刚把工作区从这个名字改走（init 据此自动更新未改动过的规范文件）
SKILL_DIRS="$HOME/.agents/skills ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
BIN_DIR="$HOME/.local/bin"
GLOBAL_ENTRIES="${CODEX_HOME:-$HOME/.codex}/AGENTS.md $HOME/.gemini/GEMINI.md"
BUILTIN_DIR=.margin
LEGACY_DIR=.local
SYSTEM_CONFIG=${MARGINALIA_SYSTEM_CONFIG:-/etc/marginalia/config}
USER_CONFIG=${MARGINALIA_USER_CONFIG:-$HOME/.marginalia/config}

say() { printf '[%s] %s\n' "$1" "$2"; }
die() { printf 'marginalia: %s\n' "$*" >&2; exit 1; }
# 没有可用的工作区（不在 git 项目中 / 项目没有初始化）：退出码 5，供其他程序区分
die_nostore() { printf 'marginalia: %s\n' "$*" >&2; exit 5; }
helper() { python3 "$MARGINALIA_HOME/lib/helpers.py" "$@"; }

usage() {
  cat <<'EOF'
用法：
  marginalia setup                       本机安装：skills 软链、marginalia 命令、各 agent 全局入口
  marginalia uninstall                   撤销 setup（不动任何项目里的私有工作区）
  marginalia init [选项] [目录]          在项目落地/修复/升级私有工作区（幂等）
      --dir <名字>                       本项目使用的目录名（默认见 marginalia config），写入项目配置
      --git-init                         目录不是 git 仓库时先 git init
      --update-spec                      用最新模板覆盖工作区的 README.md 与 templates/task.md
      --create-claude-md                 项目只有 AGENTS.md 时创建 CLAUDE.md（内容 @AGENTS.md，共享文件）
      --migrate-memory                   把 Claude 默认 auto memory 复制进工作区的 memory/
  marginalia migrate [--to <名字>] [--dry-run] [目录]
                                         把已有工作区改名（默认改为当前默认目录名，如旧版 .local → .margin）
  marginalia config [--list]             各级配置与生效的目录名
  marginalia config [级别] dir [名字]    读取/设置目录名；级别：--system | --user | --project
  marginalia config <级别> --unset dir   删除该级别的设置
  marginalia task new <slug> [标题]      新建任务
  marginalia task list [--json] [--archived]   列出未归档任务（--json 输出机器可读结果，--archived 含已归档）
  marginalia task show <slug> --json     单个任务的详情（含接续指引），机器可读
  marginalia task status <slug> <状态>   active | paused | blocked | done
  marginalia task archive <slug> [结果] [--force]   归档（状态不是 done 时需 --force）
  marginalia --version

目录名优先级（高 → 低）：项目（.git/config 的 marginalia.dir）> 环境变量 MARGINALIA_DIR
> 用户（~/.marginalia/config）> 系统（/etc/marginalia/config）> 内置 .margin。
init 会把实际使用的目录名写进项目配置，之后改默认值不影响已有项目。

输出中的 [ASK] 表示需要用户决定，[CONFLICT] 表示未自动处理的冲突。
EOF
}

# ---------------------------------------------------------------- 目录名与配置

valid_dir() { # <名字>：工作区目录名只能是项目根下的一级名字（只含字母数字和 . _ -）
  case $1 in ''|.|..) return 1 ;; esac
  # 末尾加 x：命令替换会吞掉结尾的换行，换行字符也要被拦下
  [ "$(printf '%s' "$1" | LC_ALL=C tr -d 'A-Za-z0-9._-'; echo x)" = x ] || return 1
  # 大小写不敏感的文件系统（macOS 默认）上 .Git 就是 .git
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    .git|.claude|.agents) return 1 ;;
  esac
}

# git config --get：键不存在时退出码 1（当作未设置），其他非零是文件损坏或读不了，要报出来
conf_get() { # <配置文件>：读 marginalia.dir，没有则输出空
  [ -e "$1" ] || return 0
  local v rc=0
  v=$(git config -f "$1" --get marginalia.dir) || rc=$?
  [ $rc -le 1 ] || die "无法读取配置文件 $1（git config 退出码 ${rc}）"
  printf '%s' "$v"
}

project_conf() { # <项目根>：主仓库 .git/config 里的 marginalia.dir（worktree 共用）
  local v rc=0
  v=$(git -C "$1" config --local --get marginalia.dir) || rc=$?
  [ $rc -le 1 ] || die "无法读取 $1 的 git 配置（git config 退出码 ${rc}）"
  printf '%s' "$v"
}

checked() { # <名字> <来源>：配置值不合法时报错并指出来源
  valid_dir "$1" || die "目录名不合法：$1（来自 $2）"
  printf '%s' "$1"
}

# 新项目使用的目录名（不含项目级）：环境变量 > 用户 > 系统 > 内置，结果在 D / D_SRC
default_dir() {
  local v
  if [ -n "${MARGINALIA_DIR:-}" ]; then D=$(checked "$MARGINALIA_DIR" MARGINALIA_DIR); D_SRC="env"; return; fi
  v=$(conf_get "$USER_CONFIG")
  if [ -n "$v" ]; then D=$(checked "$v" "$USER_CONFIG"); D_SRC=user; return; fi
  v=$(conf_get "$SYSTEM_CONFIG")
  if [ -n "$v" ]; then D=$(checked "$v" "$SYSTEM_CONFIG"); D_SRC=system; return; fi
  D=$BUILTIN_DIR; D_SRC=builtin
}

is_ws() { [ -d "$1/.git" ] && [ -d "$1/tasks" ]; }

# 项目当前使用的目录名：项目配置 > 默认值（目录已存在时）> 旧版 .local（存在时）> 默认值
# 环境变量只覆盖默认值、不覆盖项目配置：否则 shell 里的一个变量会让所有已有项目找不到工作区
resolve_dir() { # <项目根>
  local v
  v=$(project_conf "$1")
  if [ -n "$v" ]; then D=$(checked "$v" "项目配置 marginalia.dir"); D_SRC=project; return; fi
  default_dir
  if [ "$D" != "$LEGACY_DIR" ] && ! is_ws "$1/$D" && is_ws "$1/$LEGACY_DIR"; then D=$LEGACY_DIR; D_SRC=legacy; fi
}

pin_dir() { # <主工作区> <名字>
  if [ "$(project_conf "$1")" = "$2" ]; then
    say SKIPPED "项目配置 marginalia.dir = $2"
  else
    git -C "$1" config --local marginalia.dir "$2"; say CREATED "项目配置 marginalia.dir = $2（$1/.git/config）"
  fi
}

# 任务库身份存进工作区自己的 git config，改目录名后保持不变（trine 的会话关联靠它）
ensure_store_id() { # <工作区>
  [ -d "$1/.git" ] || return 0
  git -C "$1" config --local --get marginalia.storeId >/dev/null 2>&1 && return 0
  git -C "$1" config --local marginalia.storeId "$(helper store-id "$1")"
}

cmd_config() {
  local level="" unset=0 list=0 key="" value="" have_value=0 a root="" file r
  for a in "$@"; do
    case $a in
      --system|--user|--project) level=${a#--} ;;
      --unset) unset=1 ;;
      --list|-l) list=1 ;;
      -*) die "未知选项 $a" ;;
      *) if [ -z "$key" ]; then key=$a; else value=$a; have_value=1; fi ;;
    esac
  done
  [ -z "$key" ] || [ "$key" = dir ] || die "未知配置项：${key}（目前只有 dir）"
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$root" ]; then
    if r=$(inside_ws "$root"); then root=$r; fi
    root=$(main_root "$root")
  fi

  if [ -z "$key" ] || [ $list = 1 ]; then
    [ $unset = 0 ] && [ $have_value = 0 ] || die "用法：marginalia config <级别> [--unset] dir [名字]"
    row() { printf '%-8s %-44s %s\n' "$1" "$2" "${3:-（未设置）}"; }
    row system "$SYSTEM_CONFIG" "$(conf_get "$SYSTEM_CONFIG")"
    row user "$USER_CONFIG" "$(conf_get "$USER_CONFIG")"
    row env MARGINALIA_DIR "${MARGINALIA_DIR:-}"
    if [ -n "$root" ]; then
      row project "$root/.git/config" "$(project_conf "$root")"
      resolve_dir "$root"; echo "本项目：${D}（${D_SRC}）"
    else
      row project "（不在 git 项目中）" ""
    fi
    default_dir; echo "新项目默认：${D}（${D_SRC}）"
    return
  fi

  if [ -z "$level" ]; then
    [ $unset = 0 ] && [ $have_value = 0 ] || die "设置或删除时需要指定级别：--system | --user | --project"
    if [ -n "$root" ]; then resolve_dir "$root"; else default_dir; fi
    echo "$D"; return
  fi

  if [ $have_value = 0 ] && [ $unset = 0 ]; then
    case $level in
      system) conf_get "$SYSTEM_CONFIG" ;;
      user) conf_get "$USER_CONFIG" ;;
      project) [ -n "$root" ] || die "不在 git 项目中"; project_conf "$root" ;;
    esac
    echo; return
  fi
  [ $unset = 0 ] || [ $have_value = 0 ] || die "--unset 不需要名字"
  [ $unset = 1 ] || valid_dir "$value" || die "目录名不合法：${value}（只能是项目根下的一级名字，不能是 .git 等）"

  if [ "$level" = project ]; then
    [ -n "$root" ] || die "不在 git 项目中"
    # 已有工作区时改项目配置等于让项目找不到它，改名走 migrate
    resolve_dir "$root"
    local cur=$D want
    if [ $unset = 1 ]; then default_dir; want=$D; else want=$value; fi
    if [ "$cur" != "$want" ] && is_ws "$root/$cur"; then
      die "项目已有工作区 $cur/，改名请用 marginalia migrate --to $want"
    fi
    if [ $unset = 1 ]; then
      git -C "$root" config --local --unset marginalia.dir || true; say REMOVED "项目配置 marginalia.dir"
    else
      git -C "$root" config --local marginalia.dir "$value"; say UPDATED "项目配置 marginalia.dir = $value"
    fi
    return
  fi
  if [ "$level" = system ]; then file=$SYSTEM_CONFIG; else file=$USER_CONFIG; fi
  if [ $unset = 1 ]; then
    [ -f "$file" ] && git config -f "$file" --unset marginalia.dir || true
    say REMOVED "$file marginalia.dir"
  else
    mkdir -p "$(dirname "$file")" 2>/dev/null || die "无法创建 $(dirname "$file")（系统级配置可能需要 sudo）"
    git config -f "$file" marginalia.dir "$value" || die "无法写入 ${file}（系统级配置可能需要 sudo）"
    say UPDATED "$file marginalia.dir = $value"
  fi
  say INFO "只影响之后新初始化的项目；Codex / Gemini 的全局入口按默认目录名生成，重跑 marginalia setup 更新"
}

main_root() { # <工作树根>：主工作区根（worktree 时不同）
  dirname "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)"
}

# ---------------------------------------------------------------- setup / uninstall

link() { # <src> <dst>
  local src=$1 dst=$2
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    say SKIPPED "$dst"
  elif [ -L "$dst" ]; then
    ln -sfn "$src" "$dst"; say FIXED "$dst → $src"
  elif [ -e "$dst" ]; then
    say CONFLICT "$dst 已存在且不是软链，未处理"
  else
    mkdir -p "$(dirname "$dst")"; ln -s "$src" "$dst"; say CREATED "$dst → $src"
  fi
}

unlink_ours() { # <dst> <src>：只删除指向本仓库的软链
  if [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; then rm "$1"; say REMOVED "$1"; fi
}

cmd_setup() {
  local s dir f
  for s in "$MARGINALIA_HOME"/skills/*/; do
    s=${s%/}
    for dir in $SKILL_DIRS; do link "$s" "$dir/$(basename "$s")"; done
  done
  link "$SELF" "$BIN_DIR/marginalia"
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *) say WARN "$BIN_DIR 不在 PATH 中" ;; esac

  default_dir
  for f in $GLOBAL_ENTRIES; do
    if [ -d "$(dirname "$f")" ]; then
      say "$(helper upsert-block "$f" "$(helper render "$TPL/agent-global-block.md" - "DIR=$D")")" "$f 全局入口"
    else
      say SKIPPED "$(dirname "$f") 不存在（对应工具未安装，装好后重跑 setup）"
    fi
  done
}

cmd_uninstall() {
  local s dir f
  for s in "$MARGINALIA_HOME"/skills/*/; do
    s=${s%/}
    for dir in $SKILL_DIRS; do unlink_ours "$dir/$(basename "$s")" "$s"; done
  done
  unlink_ours "$BIN_DIR/marginalia" "$SELF"
  for f in $GLOBAL_ENTRIES; do
    say "$(helper remove-block "$f")" "$f 全局入口"
  done
  say INFO "项目内的私有工作区、CLAUDE.local.md 托管块等未改动"
}

# ---------------------------------------------------------------- init

# 当前目录（git 根）若是某项目的私有工作区仓库，输出项目根
inside_ws() { # <git 根>
  local parent ptop
  parent=$(dirname "$1")
  ptop=$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ "$ptop" = "$parent" ] || return 1
  ( resolve_dir "$parent" 2>/dev/null; [ "$(basename "$1")" = "$D" ] ) || return 1
  printf '%s' "$parent"
}

src_label() {
  case $1 in
    project) echo 项目配置 ;; env) echo 环境变量 MARGINALIA_DIR ;; user) echo "用户配置 $USER_CONFIG" ;;
    system) echo "系统配置 $SYSTEM_CONFIG" ;; builtin) echo 内置默认 ;; legacy) echo 旧版目录名 ;; flag) echo --dir ;;
  esac
}

# CLAUDE.md / AGENTS.md 检查与 CLAUDE.local.md 托管块（目录名取自 D）
claude_entry() { # <工作树根> <是否 --create-claude-md>
  local root=$1 create_claude=$2 has_claude=0 imports=0 has_agents=0 block f
  [ -f "$root/AGENTS.md" ] && has_agents=1
  for f in "$root/CLAUDE.md" "$root/.claude/CLAUDE.md"; do
    if [ -f "$f" ]; then
      has_claude=1
      if grep -qE '^[[:space:]]*@(\./)?AGENTS\.md[[:space:]]*$' "$f"; then imports=1; fi
    fi
  done
  if [ $has_agents = 1 ] && [ $has_claude = 0 ]; then
    if [ "$create_claude" = 1 ]; then
      printf '@AGENTS.md\n' > "$root/CLAUDE.md"; has_claude=1
      say CREATED "CLAUDE.md（@AGENTS.md）——共享文件，需要提交到主仓库"
    else
      say ASK "项目只有 AGENTS.md。建议创建共享的 CLAUDE.md（内容 @AGENTS.md），加 --create-claude-md；在此之前 CLAUDE.local.md 托管块内会带 @AGENTS.md 兜底"
    fi
  elif [ $has_agents = 1 ] && [ $imports = 0 ]; then
    say WARN "CLAUDE.md 没有 import AGENTS.md，Claude 不会读 AGENTS.md；建议在 CLAUDE.md 中加一行 @AGENTS.md"
  fi
  block=$(helper render "$TPL/claude-local-block.md" - "DIR=$D")
  # 项目没有 CLAUDE.md 时，CLAUDE.local.md 的存在会让 Claude 不读 AGENTS.md，这里 import 兜底（文件不存在时会被静默跳过）
  if [ $has_claude = 0 ]; then block="$block

@AGENTS.md"; fi
  say "$(helper upsert-block "$root/CLAUDE.local.md" "$block")" "CLAUDE.local.md 托管块"
}

# Claude auto memory 指向工作区的 memory/（必须是绝对路径）
memory_entry() { # <工作树根> <memory 绝对路径> [旧路径]
  local r
  mkdir -p "$1/.claude"
  r=$(helper set-memory-dir "$1/.claude/settings.local.json" "$2" "${3:-}")
  say "${r%% *}" ".claude/settings.local.json autoMemoryDirectory → $2${r#"${r%% *}"}"
}

cmd_init() {
  local git_init=0 update_spec=0 create_claude=0 migrate=0 dir="" want=""
  while [ $# -gt 0 ]; do
    case $1 in
      --dir) [ $# -ge 2 ] || die "--dir 需要目录名"; want=$2; shift ;;
      --dir=*) want=${1#--dir=} ;;
      --git-init) git_init=1 ;;
      --update-spec) update_spec=1 ;;
      --create-claude-md) create_claude=1 ;;
      --migrate-memory) migrate=1 ;;
      -*) die "未知选项 $1" ;;
      *) dir=$1 ;;
    esac
    shift
  done
  [ -z "$want" ] || valid_dir "$want" || die "目录名不合法：${want}（只能是项目根下的一级名字，不能是 .git 等）"
  [ -d "${dir:-.}" ] || die "目录不存在：$dir"
  dir=$(cd "${dir:-.}" && pwd -P)

  local ROOT
  if ROOT=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
    if inside_ws "$ROOT" >/dev/null; then die "当前在私有工作区仓库内，请在项目根运行"; fi
  elif [ $git_init = 1 ]; then
    git -C "$dir" init -q; ROOT=$dir; say CREATED "主仓库 git init：$ROOT"
  else
    say ASK "$dir 不是 git 仓库，私有排除依赖 git。确认要在这里初始化后，加 --git-init 重跑"
    exit 3
  fi
  local MAIN L changed="" d f def
  MAIN=$(main_root "$ROOT")
  resolve_dir "$MAIN"
  if [ -n "$want" ] && [ "$want" != "$D" ]; then
    if is_ws "$MAIN/$D"; then
      say ASK "项目已有工作区 $D/；要改名为 $want/，运行 marginalia migrate --to $want"
      exit 3
    fi
    D=$want; D_SRC=flag
  fi
  L="$ROOT/$D"
  say INFO "项目根：$ROOT"
  say INFO "工作区目录：$D/（$(src_label "$D_SRC")）"

  # worktree 与主工作区共享同一个工作区（和 Claude auto memory 跨 worktree 共享的行为一致）
  if [ "$MAIN" != "$ROOT" ]; then
    [ -d "$MAIN/$D" ] || die "这是 $MAIN 的 worktree，先在主工作区运行 marginalia init"
    if [ -L "$L" ] && [ "$(readlink "$L")" = "$MAIN/$D" ]; then
      say SKIPPED "$D → $MAIN/$D"; L="$MAIN/$D"
    elif [ -e "$L" ]; then
      say CONFLICT "worktree 里已有独立的 ${D}，未改为与主工作区共享"
    else
      ln -s "$MAIN/$D" "$L"; say CREATED "$D → $MAIN/${D}（与主工作区共享）"; L="$MAIN/$D"
    fi
  fi

  # 1. 骨架与模板（模板里的 {{DIR}} 渲染为实际目录名）
  for d in tasks/archived docs ops scripts templates memory out logs tmp; do mkdir -p "$L/$d"; done
  copy_tpl() { # <模板> <工作区内相对路径> <是否为托管规范>
    local src=$1 rel=$2 managed=$3 dst="$L/$2" new
    new=$(mktemp "$L/tmp/marginalia-$(basename "$rel" .md)-XXXXXX")
    helper render "$src" "$new" "DIR=$D"
    if [ ! -e "$dst" ]; then
      mv "$new" "$dst"; changed="$changed $rel"; say CREATED "$D/$rel"
    elif [ "$managed" = 1 ] && ! cmp -s "$new" "$dst"; then
      if [ $update_spec = 1 ]; then
        mv "$new" "$dst"; changed="$changed $rel"; say UPDATED "$D/${rel}（旧版可在工作区 git 历史中找回）"
      elif [ -n "$PREV_DIR" ] && [ "$(helper spec-pristine "$dst" "$rel" "$src" "$PREV_DIR")" = yes ]; then
        # 刚改过目录名、文件没被改过：只是名字不同，直接更新
        mv "$new" "$dst"; changed="$changed $rel"; say UPDATED "$D/${rel}（目录名随迁移更新）"
      else
        say ASK "$D/$rel 与最新模板不同（diff -u $dst ${new} 查看）；更新加 --update-spec"; return
      fi
    fi
    rm -f "$new"
  }
  copy_tpl "$TPL/local/README.md" README.md 1
  copy_tpl "$TPL/local/task.md" templates/task.md 1
  copy_tpl "$TPL/local/gitignore" .gitignore 0
  copy_tpl "$TPL/local/todo.md" todo.md 0
  copy_tpl "$TPL/local/MEMORY.md" memory/MEMORY.md 0

  if [ ! -d "$L/.git" ]; then
    git -C "$L" init -q; say CREATED "$D git 仓库"
  fi
  ensure_store_id "$L"
  # 钉住目录名：之后改默认值不影响本项目
  pin_dir "$MAIN" "$D"

  # 2. 私有排除（.git/info/exclude，worktree 共用；目录名不带尾斜杠，以便匹配 worktree 里的软链）
  local EX added=0 p tracked
  EX=$(git -C "$ROOT" rev-parse --path-format=absolute --git-path info/exclude)
  mkdir -p "$(dirname "$EX")"; touch "$EX"
  for p in "$D" CLAUDE.local.md .claude/settings.local.json '.claude/skills/local-*' .claude/commands/local/ \
           '.claude/agents/local-*.md' '.claude/rules/local-*.md' '.agents/skills/local-*'; do
    if ! grep -qxF -- "$p" "$EX"; then
      [ $added = 0 ] && printf '\n# marginalia: private workspace\n' >> "$EX"
      echo "$p" >> "$EX"; added=$((added + 1))
    fi
  done
  if [ $added -gt 0 ]; then say CREATED "exclude 规则 $added 条 → $EX"; else say SKIPPED "exclude 规则已齐全"; fi
  tracked=$(git -C "$ROOT" ls-files -- "$D" CLAUDE.local.md .claude/settings.local.json | tr '\n' ' ')
  [ -z "$tracked" ] || say CONFLICT "以下私有路径已被主仓库跟踪，exclude 对它们不生效（未擅自 git rm --cached）：$tracked"

  # 3. CLAUDE.md / AGENTS.md / CLAUDE.local.md
  claude_entry "$ROOT" "$create_claude"

  # 4. Claude auto memory 指向工作区的 memory/
  memory_entry "$ROOT" "$L/memory"

  # 5. 迁移 Claude 默认 auto memory（目录名由主工作区路径中的非字母数字字符替换为 - 得到）
  local old base
  old="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(printf '%s' "$MAIN" | sed 's/[^A-Za-z0-9]/-/g')/memory"
  if [ -d "$old" ] && [ -n "$(ls -A "$old")" ]; then
    if [ $migrate = 1 ]; then
      for f in "$old"/*; do
        base=$(basename "$f")
        if [ "$base" = MEMORY.md ] && cmp -s "$L/memory/MEMORY.md" "$TPL/local/MEMORY.md"; then
          cp "$f" "$L/memory/MEMORY.md"
        elif [ -e "$L/memory/$base" ]; then
          say WARN "memory/$base 已存在，未覆盖（旧文件：${f}）"; continue
        else
          cp -R "$f" "$L/memory/"
        fi
        changed="$changed memory/$base"
      done
      say MIGRATED "$old → $D/memory/（原目录保留，确认无误后可删除）"
    else
      say ASK "Claude 默认 auto memory 目录有内容：${old}；迁移进 $D/memory/ 加 --migrate-memory"
    fi
  fi

  # 6. commit 本次在工作区中的变更
  # shellcheck disable=SC2086  # changed 是空格分隔的相对路径列表，均不含空格
  [ -z "$changed" ] || lcommit "$L" "chore: marginalia init" $changed

  if [ "$D_SRC" = legacy ]; then
    def=$(default_dir; printf '%s' "$D")
    say ASK "本项目沿用旧版目录名 ${LEGACY_DIR}/（已写入项目配置）；改为 $def/ 运行 marginalia migrate（可先加 --dry-run 查看）"
  fi
  if [ -z "$(find "$L/tasks" -mindepth 1 -maxdepth 1 -type d ! -name archived)" ]; then
    say INFO "还没有任务。预计一周以上的新项目可以走 marginalia-kickoff 启动引导"
  fi
}

# ---------------------------------------------------------------- migrate

cmd_migrate() {
  local to="" dry=0 dir="" a
  while [ $# -gt 0 ]; do
    case $1 in
      --to) [ $# -ge 2 ] || die "--to 需要目录名"; to=$2; shift ;;
      --to=*) to=${1#--to=} ;;
      --dry-run|-n) dry=1 ;;
      -*) die "未知选项 $1" ;;
      *) dir=$1 ;;
    esac
    shift
  done
  [ -d "${dir:-.}" ] || die "目录不存在：$dir"
  dir=$(cd "${dir:-.}" && pwd -P)
  local ROOT MAIN from moved=0 r wt wts="" EX refs pf pt problems="" root
  ROOT=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die_nostore "不在 git 项目中"
  if r=$(inside_ws "$ROOT"); then ROOT=$r; fi
  MAIN=$(main_root "$ROOT")

  # 上次迁移没走完：项目配置里留着 migrateFrom / migrateTo，按它继续
  pf=$(git -C "$MAIN" config --local --get marginalia.migrateFrom || true)
  pt=$(git -C "$MAIN" config --local --get marginalia.migrateTo || true)
  if [ -n "$pf" ] && [ -n "$pt" ]; then
    [ -z "$to" ] || [ "$to" = "$pt" ] || die "上次的迁移 $pf → $pt 还没完成，先不带 --to 重跑 marginalia migrate 完成它"
    from=$pf; to=$pt
    say INFO "继续上次未完成的迁移：$from → $to"
  else
    resolve_dir "$MAIN"; from=$D
    if [ -z "$to" ]; then default_dir; to=$D; fi
  fi
  valid_dir "$to" || die "目录名不合法：${to}（只能是项目根下的一级名字，不能是 .git 等）"

  if [ "$from" = "$to" ]; then
    is_ws "$MAIN/$to" || die_nostore "项目没有私有工作区（$to/），先运行 marginalia init"
    say SKIPPED "工作区已是 $to/，无需迁移"; return
  fi
  if [ ! -e "$MAIN/$from" ] && [ ! -L "$MAIN/$from" ] && is_ws "$MAIN/$to"; then
    moved=1; say INFO "$from/ 已移到 $to/（上次迁移中断），继续完成剩余步骤"
  elif ! is_ws "$MAIN/$from" || [ -L "$MAIN/$from" ]; then
    die_nostore "项目没有私有工作区（$from/）"
  elif [ -e "$MAIN/$to" ] || [ -L "$MAIN/$to" ]; then
    die "$MAIN/$to 已存在，未迁移"
  fi
  local L="$MAIN/$to" OLD="$MAIN/$from"

  while IFS= read -r wt; do
    [ "$wt" = "$MAIN" ] || [ ! -d "$wt" ] || wts="$wts
$wt"
  done <<WTS
$(git -C "$MAIN" worktree list --porcelain | sed -n 's/^worktree //p')
WTS

  # 先检查完所有工作树再动手：任何一处冲突都不迁移，避免半途留下找不到的工作区或失去排除的目录
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    r=$(git -C "$root" ls-files -- "$to" CLAUDE.local.md .claude/settings.local.json | tr '\n' ' ')
    [ -z "$r" ] || problems="$problems
${root}：以下路径受版本控制，迁移要改写它们：$r"
    [ "$root" != "$MAIN" ] || continue
    if [ -L "$root/$from" ] && [ "$(readlink "$root/$from")" != "$OLD" ]; then
      problems="$problems
$root/$from 是指向 $(readlink "$root/$from") 的软链，不属于主工作区"
    elif [ -e "$root/$from" ] && [ ! -L "$root/$from" ]; then
      problems="$problems
$root/$from 是 worktree 自己的独立目录"
    fi
    if { [ -e "$root/$to" ] || [ -L "$root/$to" ]; } && ! { [ -L "$root/$to" ] && [ "$(readlink "$root/$to")" = "$L" ]; }; then
      problems="$problems
$root/$to 已存在"
    fi
  done <<WTS
$MAIN$wts
WTS
  if [ -n "$problems" ]; then
    printf '%s\n' "$problems" | sed '/^$/d' | while IFS= read -r r; do say CONFLICT "$r"; done
    die "有冲突，未迁移；处理后重跑"
  fi

  EX=$(git -C "$MAIN" rev-parse --path-format=absolute --git-path info/exclude)
  if [ $moved = 1 ]; then refs=$(helper find-refs "$L" "$from"); else refs=$(helper find-refs "$OLD" "$from"); fi

  if [ $dry = 1 ]; then
    [ $moved = 1 ] || say PLAN "移动 $OLD → $L"
    say PLAN "exclude 规则 $from → ${to}（${EX}）"
    while IFS= read -r wt; do
      [ -n "$wt" ] || continue
      if [ -L "$wt/$from" ]; then say PLAN "worktree 软链 $wt/$from → $wt/$to"; fi
    done <<WTS
$wts
WTS
    say PLAN "更新各工作树的 CLAUDE.local.md 托管块与 .claude/settings.local.json"
    say PLAN "项目配置 marginalia.dir = $to"
    [ -z "$refs" ] || say WARN "以下文件正文提到 $from/，迁移不会改写，需要的话手动更新：$(printf '%s' "$refs" | tr '\n' ' ')"
    say INFO "迁移后正在运行的 agent 会话需要重启（auto memory 路径会变）"
    return
  fi

  git -C "$MAIN" config --local marginalia.migrateFrom "$from"
  git -C "$MAIN" config --local marginalia.migrateTo "$to"
  if [ $moved = 0 ]; then
    ensure_store_id "$OLD"
    # 移动前后项目配置都指向实际存在的目录：先钉旧名，移动后再钉新名
    [ -n "$(project_conf "$MAIN")" ] || git -C "$MAIN" config --local marginalia.dir "$from"
    mv "$OLD" "$L"; say MOVED "$OLD → $L"
  fi
  pin_dir "$MAIN" "$to"
  say "$(helper exclude-rename "$EX" "$from" "$to")" "exclude 规则 $from → $to"

  local had
  D=$to
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    had=0
    if [ -L "$wt/$from" ]; then rm "$wt/$from"; had=1; fi   # 预检保证它指向主工作区
    if [ -L "$wt/$to" ]; then
      :
    elif [ $had = 1 ] || grep -qF '<!-- marginalia:start -->' "$wt/CLAUDE.local.md" 2>/dev/null; then
      ln -s "$L" "$wt/$to"; say FIXED "worktree $wt/$to → $L"
    else
      continue  # 这个 worktree 没有初始化过
    fi
    say INFO "worktree：$wt"
    if grep -qF '<!-- marginalia:start -->' "$wt/CLAUDE.local.md" 2>/dev/null; then claude_entry "$wt" 0; fi
    memory_entry "$wt" "$L/memory" "$OLD/memory"
  done <<WTS
$wts
WTS
  say INFO "主工作区：$MAIN"
  memory_entry "$MAIN" "$L/memory" "$OLD/memory"
  # 主工作区其余部分（托管块、规范文件等）交给 init；init 失败（如 commit 失败）时标记保留，重跑继续
  PREV_DIR=$from
  cmd_init "$MAIN"
  git -C "$MAIN" config --local --unset marginalia.migrateFrom || true
  git -C "$MAIN" config --local --unset marginalia.migrateTo || true
  [ -z "$refs" ] || say WARN "以下文件正文提到 $from/，未改写，需要的话手动更新：$(printf '%s' "$refs" | tr '\n' ' ')"
  say INFO "迁移完成。正在运行的 agent 会话需要重启（auto memory 路径已变）"
}

# ---------------------------------------------------------------- task

# 在工作区仓库里只提交指定路径：用户另外暂存的改动不会被一起提交
# 文件已改但 commit 失败（hook、签名等）时以退出码 4 报告，与「没改动」区分开
lcommit() { # <工作区> <message> <paths...>
  local L=$1 msg=$2 p
  shift 2
  for p in "$@"; do git -C "$L" add -A -- "$p" 2>/dev/null || true; done
  git -C "$L" diff --cached --quiet -- "$@" && return 0
  if git -C "$L" commit -q -m "$msg" -- "$@"; then
    say COMMITTED "$msg"
  else
    printf 'marginalia: 文件已修改，但工作区的 commit 失败：%s\n' "$msg" >&2
    exit 4
  fi
}

find_local() {
  local top r
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die_nostore "不在 git 项目中"
  if r=$(inside_ws "$top"); then top=$r; fi
  resolve_dir "$top"
  L="$top/$D"
  # 必须是独立 git 仓库，否则任务会被提交进外层的主仓库
  is_ws "$L" || die_nostore "项目没有私有工作区（$D/），先运行 marginalia init"
}

valid_slug() {
  printf '%s' "$1" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$' || die "slug 需为 kebab-case：$1"
}

# 是否带 --json（从参数里拿掉后放回 ARGS）
JSON=0
take_json() {
  ARGS=()
  local a
  for a in "$@"; do
    if [ "$a" = --json ]; then JSON=1; else ARGS+=("$a"); fi
  done
}

cmd_task() {
  local L sub=${1:-list}
  [ $# -gt 0 ] && shift
  find_local
  case $sub in
    new)
      [ $# -gt 0 ] || die "需要 slug"
      local slug=$1 title tpl
      shift
      valid_slug "$slug"
      title=${*:-$slug}
      if [ -e "$L/tasks/$slug" ] || [ -e "$L/tasks/archived/$slug" ]; then die "任务已存在：$slug"; fi
      tpl="$L/templates/task.md"; [ -f "$tpl" ] || tpl="$TPL/local/task.md"
      mkdir -p "$L/tasks/$slug"
      helper render "$tpl" "$L/tasks/$slug/README.md" "TITLE=$title" "DATE=$TODAY"
      say CREATED "$L/tasks/$slug/README.md"
      lcommit "$L" "task($slug): create" "tasks/$slug"
      ;;
    list)
      local f n=0 archived=0 slug with_archived=0 a
      for a in "$@"; do
        case $a in
          --json) JSON=1 ;;
          --archived) with_archived=1 ;;
          *) die "未知参数：$a" ;;
        esac
      done
      if [ $JSON = 1 ]; then
        helper tasks-json "$L" "$with_archived"
        return
      fi
      printf '%-28s %-8s %-11s %s\n' TASK STATUS UPDATED 当前状态
      for f in "$L"/tasks/*/README.md; do
        [ -e "$f" ] || continue
        slug=$(basename "$(dirname "$f")")
        [ "$slug" = archived ] && continue
        printf '%-28s %-8s %-11s %s\n' "$slug" "$(helper fm-get "$f" status)" \
          "$(helper fm-get "$f" updated)" "$(helper section-field "$f" 当前状态)"
        n=$((n + 1))
      done
      [ $n -gt 0 ] || echo "（没有未归档任务）"
      for f in "$L"/tasks/archived/*/; do [ -d "$f" ] && archived=$((archived + 1)); done
      if [ $with_archived = 1 ]; then
        for f in "$L"/tasks/archived/*/README.md; do
          [ -e "$f" ] || continue
          printf '%-28s %-8s %-11s %s\n' "$(basename "$(dirname "$f")")" archived \
            "$(helper fm-get "$f" archived)" "$(helper fm-get "$f" result)"
        done
      fi
      echo "已归档：$archived 个"
      ;;
    show)
      take_json "$@"
      [ ${#ARGS[@]} -eq 1 ] || die "用法：marginalia task show <slug> --json"
      [ $JSON = 1 ] || die "task show 目前只支持 --json"
      local slug=${ARGS[0]} f
      valid_slug "$slug"
      f="$L/tasks/$slug/README.md"
      [ -f "$f" ] || f="$L/tasks/archived/$slug/README.md"
      [ -f "$f" ] || die "没有任务：$slug"
      helper task-json "$L" "$f"
      ;;
    status)
      [ $# -ge 2 ] || die "用法：marginalia task status <slug> <$STATUSES>"
      local slug=$1 st=$2 f
      valid_slug "$slug"
      f="$L/tasks/$slug/README.md"
      [ -f "$f" ] || die "没有任务：$slug"
      case " $STATUSES " in *" $st "*) ;; *) die "状态须为：$STATUSES" ;; esac
      helper fm-set "$f" status "$st"
      helper fm-set "$f" updated "$TODAY"
      lcommit "$L" "task($slug): status → $st" "tasks/$slug"
      ;;
    archive)
      local slug="" force=0 result="" a f st
      for a in "$@"; do
        case $a in
          --force) force=1 ;;
          *) if [ -z "$slug" ]; then slug=$a; else result="${result:+$result }$a"; fi ;;
        esac
      done
      [ -n "$slug" ] || die "需要 slug"
      valid_slug "$slug"
      f="$L/tasks/$slug/README.md"
      if [ ! -f "$f" ] && [ -f "$L/tasks/archived/$slug/README.md" ]; then
        # 已归档：上次移动后 commit 失败的话这里补交，否则什么都不做
        lcommit "$L" "archive($slug)" "tasks/$slug" "tasks/archived/$slug"
        say SKIPPED "tasks/archived/$slug 已归档"
        return
      fi
      [ -f "$f" ] || die "没有任务：$slug"
      st=$(helper fm-get "$f" status)
      [ "$st" = "done" ] || [ $force = 1 ] || die "任务状态是 $st 不是 done；确认要归档的话加 --force"
      helper fm-set "$f" archived "$TODAY"
      helper fm-set "$f" updated "$TODAY"
      [ -z "$result" ] || helper fm-set "$f" result "$result"
      mv "$L/tasks/$slug" "$L/tasks/archived/$slug"
      say ARCHIVED "tasks/archived/$slug"
      lcommit "$L" "archive($slug)" "tasks/$slug" "tasks/archived/$slug"
      ;;
    *) die "未知子命令：task $sub" ;;
  esac
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  init) shift; cmd_init "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  config) shift; cmd_config "$@" ;;
  task) shift; cmd_task "$@" ;;
  -V|--version|version) echo "marginalia $VERSION" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
