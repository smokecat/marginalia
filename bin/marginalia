#!/usr/bin/env bash
# marginalia — 项目私有工作区（.local/）的确定性操作。任何 agent 工具或人都可直接调用。
# 依赖：bash ≥ 3.2、git ≥ 2.31、python3 ≥ 3.8
set -euo pipefail

SELF=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")
MARGINALIA_HOME=$(dirname "$(dirname "$SELF")")
TPL="$MARGINALIA_HOME/templates"
VERSION=$(cat "$MARGINALIA_HOME/VERSION")
TODAY=$(date +%F)
STATUSES="active paused blocked done"
SKILL_DIRS="$HOME/.agents/skills ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
BIN_DIR="$HOME/.local/bin"
GLOBAL_ENTRIES="${CODEX_HOME:-$HOME/.codex}/AGENTS.md $HOME/.gemini/GEMINI.md"

say() { printf '[%s] %s\n' "$1" "$2"; }
die() { printf 'marginalia: %s\n' "$*" >&2; exit 1; }
helper() { python3 "$MARGINALIA_HOME/lib/helpers.py" "$@"; }

usage() {
  cat <<'EOF'
用法：
  marginalia setup                       本机安装：skills 软链、marginalia 命令、各 agent 全局入口
  marginalia uninstall                   撤销 setup（不动任何项目里的 .local）
  marginalia init [选项] [目录]          在项目落地/修复/升级 .local 私有工作区（幂等）
      --git-init                         目录不是 git 仓库时先 git init
      --update-spec                      用最新模板覆盖 .local/README.md 与 .local/templates/task.md
      --create-claude-md                 项目只有 AGENTS.md 时创建 CLAUDE.md（内容 @AGENTS.md，共享文件）
      --migrate-memory                   把 Claude 默认 auto memory 复制进 .local/memory/
  marginalia task new <slug> [标题]      新建任务
  marginalia task list                   列出未归档任务
  marginalia task status <slug> <状态>   active | paused | blocked | done
  marginalia task archive <slug> [结果] [--force]   归档（状态不是 done 时需 --force）
  marginalia --version

输出中的 [ASK] 表示需要用户决定，[CONFLICT] 表示未自动处理的冲突。
EOF
}

# ---------------------------------------------------------------- setup / uninstall

link() { # <src> <dst>
  local src=$1 dst=$2
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    say SKIPPED "$dst"
  elif [ -L "$dst" ]; then
    ln -sfn "$src" "$dst"; say FIXED "$dst → $src"
  elif [ -e "$dst" ]; then
    say CONFLICT "$dst 已存在且不是软链，未处理"
  else
    mkdir -p "$(dirname "$dst")"; ln -s "$src" "$dst"; say CREATED "$dst → $src"
  fi
}

unlink_ours() { # <dst> <src>：只删除指向本仓库的软链
  if [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; then rm "$1"; say REMOVED "$1"; fi
}

cmd_setup() {
  local s dir f
  for s in "$MARGINALIA_HOME"/skills/*/; do
    s=${s%/}
    for dir in $SKILL_DIRS; do link "$s" "$dir/$(basename "$s")"; done
  done
  link "$SELF" "$BIN_DIR/marginalia"
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *) say WARN "$BIN_DIR 不在 PATH 中" ;; esac

  for f in $GLOBAL_ENTRIES; do
    if [ -d "$(dirname "$f")" ]; then
      say "$(helper upsert-block "$f" "$(cat "$TPL/agent-global-block.md")")" "$f 全局入口"
    else
      say SKIPPED "$(dirname "$f") 不存在（对应工具未安装，装好后重跑 setup）"
    fi
  done
}

cmd_uninstall() {
  local s dir f
  for s in "$MARGINALIA_HOME"/skills/*/; do
    s=${s%/}
    for dir in $SKILL_DIRS; do unlink_ours "$dir/$(basename "$s")" "$s"; done
  done
  unlink_ours "$BIN_DIR/marginalia" "$SELF"
  for f in $GLOBAL_ENTRIES; do
    say "$(helper remove-block "$f")" "$f 全局入口"
  done
  say INFO "项目内的 .local/、CLAUDE.local.md 托管块等未改动"
}

# ---------------------------------------------------------------- init

cmd_init() {
  local git_init=0 update_spec=0 create_claude=0 migrate=0 dir=""
  while [ $# -gt 0 ]; do
    case $1 in
      --git-init) git_init=1 ;;
      --update-spec) update_spec=1 ;;
      --create-claude-md) create_claude=1 ;;
      --migrate-memory) migrate=1 ;;
      -*) die "未知选项 $1" ;;
      *) dir=$1 ;;
    esac
    shift
  done
  [ -d "${dir:-.}" ] || die "目录不存在：$dir"
  dir=$(cd "${dir:-.}" && pwd -P)

  local ROOT
  if ROOT=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
    [ "$(basename "$ROOT")" = .local ] && die "当前在 .local 仓库内，请在项目根运行"
  elif [ $git_init = 1 ]; then
    git -C "$dir" init -q; ROOT=$dir; say CREATED "主仓库 git init：$ROOT"
  else
    say ASK "$dir 不是 git 仓库，私有排除依赖 git。确认要在这里初始化后，加 --git-init 重跑"
    exit 3
  fi
  local L="$ROOT/.local" MAIN changed="" d f r
  say INFO "项目根：$ROOT"

  # worktree 与主工作区共享同一个 .local（和 Claude auto memory 跨 worktree 共享的行为一致）
  MAIN=$(dirname "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)")
  if [ "$MAIN" != "$ROOT" ]; then
    [ -d "$MAIN/.local" ] || die "这是 $MAIN 的 worktree，先在主工作区运行 marginalia init"
    if [ -L "$L" ] && [ "$(readlink "$L")" = "$MAIN/.local" ]; then
      say SKIPPED ".local → $MAIN/.local"; L="$MAIN/.local"
    elif [ -e "$L" ]; then
      say CONFLICT "worktree 里已有独立的 .local，未改为与主工作区共享"
    else
      ln -s "$MAIN/.local" "$L"; say CREATED ".local → $MAIN/.local（与主工作区共享）"; L="$MAIN/.local"
    fi
  fi

  # 1. .local 骨架与模板
  for d in tasks/archived docs ops scripts templates memory out logs tmp; do mkdir -p "$L/$d"; done
  copy_tpl() { # <模板> <.local 内相对路径> <是否为托管规范>
    local src=$1 rel=$2 managed=$3 dst="$L/$2"
    if [ ! -e "$dst" ]; then
      cp "$src" "$dst"; changed="$changed $rel"; say CREATED ".local/$rel"
    elif [ "$managed" = 1 ] && ! cmp -s "$src" "$dst"; then
      if [ $update_spec = 1 ]; then
        cp "$src" "$dst"; changed="$changed $rel"; say UPDATED ".local/$rel（旧版可在 .local git 历史中找回）"
      else
        say ASK ".local/$rel 与最新模板不同（diff -u $dst $src 查看）；更新加 --update-spec"
      fi
    fi
  }
  copy_tpl "$TPL/local/README.md" README.md 1
  copy_tpl "$TPL/local/task.md" templates/task.md 1
  copy_tpl "$TPL/local/gitignore" .gitignore 0
  copy_tpl "$TPL/local/todo.md" todo.md 0
  copy_tpl "$TPL/local/MEMORY.md" memory/MEMORY.md 0

  if [ ! -d "$L/.git" ]; then
    git -C "$L" init -q; say CREATED ".local git 仓库"
  fi

  # 2. 私有排除（.git/info/exclude，worktree 共用；.local 不带尾斜杠，以便匹配 worktree 里的软链）
  local EX added=0 p tracked
  EX=$(git -C "$ROOT" rev-parse --path-format=absolute --git-path info/exclude)
  mkdir -p "$(dirname "$EX")"; touch "$EX"
  for p in .local CLAUDE.local.md .claude/settings.local.json '.claude/skills/local-*' .claude/commands/local/ \
           '.claude/agents/local-*.md' '.claude/rules/local-*.md' '.agents/skills/local-*'; do
    if ! grep -qxF -- "$p" "$EX"; then
      [ $added = 0 ] && printf '\n# marginalia: private workspace\n' >> "$EX"
      echo "$p" >> "$EX"; added=$((added + 1))
    fi
  done
  if [ $added -gt 0 ]; then say CREATED "exclude 规则 $added 条 → $EX"; else say SKIPPED "exclude 规则已齐全"; fi
  tracked=$(git -C "$ROOT" ls-files -- .local CLAUDE.local.md .claude/settings.local.json | tr '\n' ' ')
  [ -z "$tracked" ] || say CONFLICT "以下私有路径已被主仓库跟踪，exclude 对它们不生效（未擅自 git rm --cached）：$tracked"

  # 3. CLAUDE.md / AGENTS.md / CLAUDE.local.md
  local has_claude=0 imports=0 has_agents=0 block
  [ -f "$ROOT/AGENTS.md" ] && has_agents=1
  for f in "$ROOT/CLAUDE.md" "$ROOT/.claude/CLAUDE.md"; do
    if [ -f "$f" ]; then
      has_claude=1
      if grep -qE '^[[:space:]]*@(\./)?AGENTS\.md[[:space:]]*$' "$f"; then imports=1; fi
    fi
  done
  if [ $has_agents = 1 ] && [ $has_claude = 0 ]; then
    if [ $create_claude = 1 ]; then
      printf '@AGENTS.md\n' > "$ROOT/CLAUDE.md"; has_claude=1
      say CREATED "CLAUDE.md（@AGENTS.md）——共享文件，需要提交到主仓库"
    else
      say ASK "项目只有 AGENTS.md。建议创建共享的 CLAUDE.md（内容 @AGENTS.md），加 --create-claude-md；在此之前 CLAUDE.local.md 托管块内会带 @AGENTS.md 兜底"
    fi
  elif [ $has_agents = 1 ] && [ $imports = 0 ]; then
    say WARN "CLAUDE.md 没有 import AGENTS.md，Claude 不会读 AGENTS.md；建议在 CLAUDE.md 中加一行 @AGENTS.md"
  fi
  block=$(cat "$TPL/claude-local-block.md")
  # 项目没有 CLAUDE.md 时，CLAUDE.local.md 的存在会让 Claude 不读 AGENTS.md，这里 import 兜底（文件不存在时会被静默跳过）
  if [ $has_claude = 0 ]; then block="$block

@AGENTS.md"; fi
  say "$(helper upsert-block "$ROOT/CLAUDE.local.md" "$block")" "CLAUDE.local.md 托管块"

  # 4. Claude auto memory 指向 .local/memory（必须是绝对路径）
  mkdir -p "$ROOT/.claude"
  r=$(helper set-memory-dir "$ROOT/.claude/settings.local.json" "$L/memory")
  say "${r%% *}" ".claude/settings.local.json autoMemoryDirectory → $L/memory${r#"${r%% *}"}"

  # 5. 迁移 Claude 默认 auto memory（目录名由主工作区路径中的非字母数字字符替换为 - 得到）
  local old base
  old="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(printf '%s' "$MAIN" | sed 's/[^A-Za-z0-9]/-/g')/memory"
  if [ -d "$old" ] && [ -n "$(ls -A "$old")" ]; then
    if [ $migrate = 1 ]; then
      for f in "$old"/*; do
        base=$(basename "$f")
        if [ "$base" = MEMORY.md ] && cmp -s "$L/memory/MEMORY.md" "$TPL/local/MEMORY.md"; then
          cp "$f" "$L/memory/MEMORY.md"
        elif [ -e "$L/memory/$base" ]; then
          say WARN "memory/$base 已存在，未覆盖（旧文件：$f）"; continue
        else
          cp -R "$f" "$L/memory/"
        fi
        changed="$changed memory/$base"
      done
      say MIGRATED "$old → .local/memory/（原目录保留，确认无误后可删除）"
    else
      say ASK "Claude 默认 auto memory 目录有内容：$old；迁移进 .local/memory/ 加 --migrate-memory"
    fi
  fi

  # 6. commit 本次在 .local 中的变更
  # shellcheck disable=SC2086  # changed 是空格分隔的相对路径列表，均不含空格
  [ -z "$changed" ] || lcommit "$L" "chore: marginalia init" $changed

  if [ -z "$(find "$L/tasks" -mindepth 1 -maxdepth 1 -type d ! -name archived)" ]; then
    say INFO "还没有任务。预计一周以上的新项目可以走 marginalia-kickoff 启动引导"
  fi
}

# ---------------------------------------------------------------- task

# 在 .local 仓库里只提交指定路径
lcommit() { # <.local> <message> <paths...>
  local L=$1 msg=$2 p
  shift 2
  for p in "$@"; do git -C "$L" add -A -- "$p" 2>/dev/null || true; done
  git -C "$L" diff --cached --quiet && return 0
  git -C "$L" commit -q -m "$msg" && say COMMITTED "$msg"
}

find_local() {
  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "不在 git 项目中"
  [ "$(basename "$top")" = .local ] && top=$(dirname "$top")
  L="$top/.local"
  [ -d "$L" ] || die "项目没有 .local/，先运行 marginalia init"
}

valid_slug() {
  printf '%s' "$1" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$' || die "slug 需为 kebab-case：$1"
}

cmd_task() {
  local L sub=${1:-list}
  [ $# -gt 0 ] && shift
  find_local
  case $sub in
    new)
      [ $# -gt 0 ] || die "需要 slug"
      local slug=$1 title tpl
      shift
      valid_slug "$slug"
      title=${*:-$slug}
      if [ -e "$L/tasks/$slug" ] || [ -e "$L/tasks/archived/$slug" ]; then die "任务已存在：$slug"; fi
      tpl="$L/templates/task.md"; [ -f "$tpl" ] || tpl="$TPL/local/task.md"
      mkdir -p "$L/tasks/$slug"
      helper render "$tpl" "$L/tasks/$slug/README.md" "TITLE=$title" "DATE=$TODAY"
      say CREATED "$L/tasks/$slug/README.md"
      lcommit "$L" "task($slug): create" "tasks/$slug"
      ;;
    list)
      local f n=0 archived=0 slug
      printf '%-28s %-8s %-11s %s\n' TASK STATUS UPDATED 当前状态
      for f in "$L"/tasks/*/README.md; do
        [ -e "$f" ] || continue
        slug=$(basename "$(dirname "$f")")
        [ "$slug" = archived ] && continue
        printf '%-28s %-8s %-11s %s\n' "$slug" "$(helper fm-get "$f" status)" \
          "$(helper fm-get "$f" updated)" "$(helper section-field "$f" 当前状态)"
        n=$((n + 1))
      done
      [ $n -gt 0 ] || echo "（没有未归档任务）"
      for f in "$L"/tasks/archived/*/; do [ -d "$f" ] && archived=$((archived + 1)); done
      echo "已归档：$archived 个"
      ;;
    status)
      [ $# -ge 2 ] || die "用法：marginalia task status <slug> <$STATUSES>"
      local slug=$1 st=$2 f
      f="$L/tasks/$slug/README.md"
      [ -f "$f" ] || die "没有任务：$slug"
      case " $STATUSES " in *" $st "*) ;; *) die "状态须为：$STATUSES" ;; esac
      helper fm-set "$f" status "$st"
      helper fm-set "$f" updated "$TODAY"
      lcommit "$L" "task($slug): status → $st" "tasks/$slug"
      ;;
    archive)
      local slug="" force=0 result="" a f st
      for a in "$@"; do
        case $a in
          --force) force=1 ;;
          *) if [ -z "$slug" ]; then slug=$a; else result="${result:+$result }$a"; fi ;;
        esac
      done
      [ -n "$slug" ] || die "需要 slug"
      f="$L/tasks/$slug/README.md"
      [ -f "$f" ] || die "没有任务：$slug"
      st=$(helper fm-get "$f" status)
      [ "$st" = "done" ] || [ $force = 1 ] || die "任务状态是 $st 不是 done；确认要归档的话加 --force"
      helper fm-set "$f" archived "$TODAY"
      helper fm-set "$f" updated "$TODAY"
      [ -z "$result" ] || helper fm-set "$f" result "$result"
      mv "$L/tasks/$slug" "$L/tasks/archived/$slug"
      say ARCHIVED "tasks/archived/$slug"
      lcommit "$L" "archive($slug)" "tasks/$slug" "tasks/archived/$slug"
      ;;
    *) die "未知子命令：task $sub" ;;
  esac
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  init) shift; cmd_init "$@" ;;
  task) shift; cmd_task "$@" ;;
  -V|--version|version) echo "marginalia $VERSION" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
